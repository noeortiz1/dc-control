# API central de DC Control
# Desarrollo local (valor por defecto si se omite): http://127.0.0.1:8000
# Produccion: reemplazar por la URL HTTPS del backend FastAPI central.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Seguridad de sesión
ENVIRONMENT=development
DC_AUTH_SECRET=replace-with-a-long-random-secret
DC_AUTH_TOKEN_TTL=28800
DC_PROFILE_PIN=replace-with-server-side-profile-pin

# Integraciones server-side (NUNCA incluir estas variables en el .exe de Electron)
DATABASE_URL=
CORS_ORIGINS=
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER=DC Control Notificaciones
TEAMS_WEBHOOK_URL=

# Optional: only for first deployment when no admin exists; do not commit the real value.
DC_BOOTSTRAP_ADMIN_USERNAME=noe.ortizadm
DC_BOOTSTRAP_ADMIN_NAME=Noe Ortiz (Director General)
DC_BOOTSTRAP_ADMIN_EMAIL=director@dccontrol.com
DC_BOOTSTRAP_ADMIN_PASSWORD=
